# PostgreSQL started by `docker compose up -d`
DATABASE_URL=postgres://proposal:proposal@localhost:5442/proposal_builder

# Public origin used for canonical URLs, the sitemap and JSON-LD.
# The app itself is served under /apps/proposal-builder (see src/config/site.ts).
SITE_ORIGIN=http://localhost:3020

# Base URL of the document renderer that turns proposals into PDFs (POST /v1/documents).
DOCUMENT_RENDERER_URL=
# Bearer token for the document renderer, if it requires one.
DOCUMENT_RENDERER_API_KEY=
